# Copie ce fichier en backend/.env (jamais dans Git) et remplis les valeurs.
# Sur Render, ces mêmes noms se saisissent dans « Environment » (les clés en « secret »).

# --- Firebase (même projet que le frontend) ---
FIREBASE_PROJECT_ID=plugstudy-2dd5f
# Contenu JSON complet du compte de service (console Firebase > Paramètres du projet > Comptes de service >
# Générer une nouvelle clé privée), sur UNE seule ligne. Ne jamais l'envoyer dans le frontend ni dans Git.
FIREBASE_CREDENTIALS_JSON=

# --- API du modèle (compatible OpenAI : /chat/completions) ---
# Modèle autorisé par la clé de l’équipe : anthropic/claude-haiku-5-5, pour toutes les tâches (notions, quiz, résumé).
# RODIUMAI_BASE_URL dépend de qui fournit la clé (le préfixe « google/ » indique une passerelle de type OpenRouter) :
#   - passerelle RodiumAI ou OpenRouter : l'adresse de leur API (par exemple https://openrouter.ai/api/v1)
#   - Google AI Studio en direct : https://generativelanguage.googleapis.com/v1beta/openai/ et le modèle SANS « google/ »
RODIUMAI_BASE_URL=
RODIUMAI_API_KEY=
RODIUM_MODEL_STRONG=anthropic/claude-haiku-5-5
RODIUM_MODEL_FAST=anthropic/claude-haiku-5-5
RODIUM_MODEL_EMBEDDING=text-embedding-3-small
# Embeddings : seulement pour l'assistant (caché dans le MVP). Laisser à false.
RODIUM_EMBEDDINGS_ENABLED=false

# --- Sécurité et limites ---
# Adresses du frontend autorisées à appeler l'API, séparées par des virgules.
ALLOWED_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=100
RATE_LIMIT_PER_MINUTE=20
